{
  "manifest_version": 3,
  "name": "betterlink Tabs (preview)",
  "version": "0.2.0",
  "description": "Pushes tab and window events to betterlink over native messaging, and runs the app's tab commands (open, close, switch, move, mute, duplicate, reload).",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["tabs", "nativeMessaging", "favicon", "storage"],
  "background": { "service_worker": "background.js", "type": "module" }
}
