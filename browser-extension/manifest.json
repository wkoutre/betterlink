{
  "manifest_version": 3,
  "name": "betterlink Tabs (preview)",
  "version": "0.2.0",
  "description": "Connects this browser to the betterlink app for Mac: shows your tabs in betterlink's sidebar and runs its tab commands.",
  "key": "",
  "minimum_chrome_version": "116",
  "homepage_url": "https://github.com/wkoutre/betterlink",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "permissions": ["tabs", "nativeMessaging", "favicon", "storage"],
  "background": { "service_worker": "background.js", "type": "module" }
}
