{
  "manifest_version": 3,
  "name": "betterlink Tabs (preview)",
  "version": "0.1.0",
  "description": "Pushes tab and window events to betterlink over native messaging, and runs the app's open, close and activate commands.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["tabs", "nativeMessaging", "favicon"],
  "background": { "service_worker": "background.js", "type": "module" }
}
